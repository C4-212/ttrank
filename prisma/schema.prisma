// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin {
  idx         Int      @id @default(autoincrement())
  id          String   @unique
  password    String
  token       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
}

model match {
  idx                         Int      @id @default(autoincrement())
  team1_player1_name          String
  team1_player1_mmr           Int
  team1_player1_mmr_changed   Int?
  team1_player2_name          String
  team1_player2_mmr           Int
  team1_player2_mmr_changed   Int?
  team2_player1_name          String
  team2_player1_mmr           Int
  team2_player1_mmr_changed   Int?
  team2_player2_name          String
  team2_player2_mmr           Int
  team2_player2_mmr_changed   Int?
  created_at                  DateTime @default(now())
  updated_at                  DateTime @default(now())
  status                      String @default("play")
}

model player {
  idx         Int       @id @default(autoincrement())
  name        String    @unique
  battle_tag  String?
  player_mmr  Int       @default(1000)
  streak      Int       @default(0)
  point       Int       @default(0)
  win         Int       @default(0)
  lose        Int       @default(0)
}

