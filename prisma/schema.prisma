// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin {
  idx         Int      @id @default(autoincrement())
  id          String   @unique
  password    String
  token       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
}

model match {
  idx                         Int      @id @default(autoincrement())
  team1_race                  String?
  team1_player1_name          String
  team1_player1_mmr           Int
  team1_player1_mmr_changed   Int?
  team1_player1_streak        Int
  team1_player2_name          String
  team1_player2_mmr           Int
  team1_player2_mmr_changed   Int?
  team1_player2_streak        Int
  team2_race                  String?
  team2_player1_name          String
  team2_player1_mmr           Int
  team2_player1_mmr_changed   Int?
  team2_player1_streak        Int
  team2_player2_name          String
  team2_player2_mmr           Int
  team2_player2_mmr_changed   Int?
  team2_player2_streak        Int
  point                       Int @default(1)
  winner                      String?
  created_at                  DateTime @default(now())
  updated_at                  DateTime @default(now())
  status                      String @default("play")
  is_champion                 Boolean @default(false)
}

model player {
  idx         Int       @id @default(autoincrement())
  name        String    @unique
  battle_tag  String?
  mmr         Int       @default(1000)
  streak      Int       @default(0)
  point       Int       @default(0)
  win         Int       @default(0)
  lose        Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())
}

model honors {
  idx         Int       @id @default(autoincrement())
  name        String    @unique
  point       Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())
}

model fame {
  idx         Int       @id @default(autoincrement())
  name        String    
  round       Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())
  date        String    @default("1900/01/01")
}

model point {
  idx         Int       @id @default(autoincrement())
  name        String
  type        String    @default("receive")
  description String?    
  point       Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())
}

model goods {
  idx         Int       @id @default(autoincrement())
  name        String
  description String?    
  src         String?
  count       Int       @default(0)
  point       Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())
}


model statistics {
  idx               Int       @id @default(autoincrement())
  name              String    @unique
  
  Maker_ZvsZ_W      Int       @default(0)
  Maker_ZvsZ_L      Int       @default(0)
  Maker_ZvsT_W      Int       @default(0)
  Maker_ZvsT_L      Int       @default(0)
  Maker_ZvsP_W      Int       @default(0)
  Maker_ZvsP_L      Int       @default(0)
  Maker_TvsZ_W      Int       @default(0)
  Maker_TvsZ_L      Int       @default(0)
  Maker_TvsT_W      Int       @default(0)
  Maker_TvsT_L      Int       @default(0)
  Maker_TvsP_W      Int       @default(0)
  Maker_TvsP_L      Int       @default(0)
  Maker_PvsZ_W      Int       @default(0)
  Maker_PvsZ_L      Int       @default(0)
  Maker_PvsT_W      Int       @default(0)
  Maker_PvsT_L      Int       @default(0)
  Maker_PvsP_W      Int       @default(0)
  Maker_PvsP_L      Int       @default(0)

  Controller_ZvsZ_W      Int       @default(0)
  Controller_ZvsZ_L      Int       @default(0)
  Controller_ZvsT_W      Int       @default(0)
  Controller_ZvsT_L      Int       @default(0)
  Controller_ZvsP_W      Int       @default(0)
  Controller_ZvsP_L      Int       @default(0)
  Controller_TvsZ_W      Int       @default(0)
  Controller_TvsZ_L      Int       @default(0)
  Controller_TvsT_W      Int       @default(0)
  Controller_TvsT_L      Int       @default(0)
  Controller_TvsP_W      Int       @default(0)
  Controller_TvsP_L      Int       @default(0)
  Controller_PvsZ_W      Int       @default(0)
  Controller_PvsZ_L      Int       @default(0)
  Controller_PvsT_W      Int       @default(0)
  Controller_PvsT_L      Int       @default(0)
  Controller_PvsP_W      Int       @default(0)
  Controller_PvsP_L      Int       @default(0)
}